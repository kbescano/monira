# Postgres connection string from Neon (Dashboard -> Connection Details -> "Pooled connection")
DATABASE_URI=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/love-notes?sslmode=require

# Any long random string, used to sign Payload's JWTs. Generate one with:
#   openssl rand -base64 32
PAYLOAD_SECRET=

# Cloudinary (Dashboard -> Settings -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
